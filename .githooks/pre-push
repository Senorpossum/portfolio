#!/usr/bin/env bash
# .githooks/pre-push
# Protects key branches from accidental remote deletion and force-push overwrites.

set -euo pipefail

# Regex pattern of protected branch names
PROTECTED_PATTERN="^(main|master|production|release/.*|release)$"

exit_code=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Extract branch name from remote_ref (e.g. refs/heads/main -> main)
  remote_branch="${remote_ref#refs/heads/}"

  # Only inspect branches matching protected patterns
  if [[ "$remote_branch" =~ $PROTECTED_PATTERN ]]; then

    # Case 1: Remote branch deletion
    # Deletion occurs when local_sha is all zeroes, local_ref is (delete), or empty
    if [[ "$local_sha" =~ ^0+$ || "$local_ref" == "(delete)" || -z "$local_ref" ]]; then
      echo "" >&2
      echo "================================================================================" >&2
      echo "🛑 [GIT BLOCKED] Deletion of protected branch '$remote_branch' is prohibited!" >&2
      echo "   Repository policy prevents deleting protected branches on GitHub." >&2
      echo "================================================================================" >&2
      echo "" >&2
      exit_code=1
      continue
    fi

    # Case 2: Force push / history rewrite (non-fast-forward push)
    # If the remote branch already exists (remote_sha is not all zeros), check ancestry
    if [[ ! "$remote_sha" =~ ^0+$ ]]; then
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "" >&2
        echo "================================================================================" >&2
        echo "🛑 [GIT BLOCKED] Force-pushing to protected branch '$remote_branch' is prohibited!" >&2
        echo "   Remote branch '$remote_branch' would lose commits (non-fast-forward)." >&2
        echo "   To protect commit history, force-pushes are blocked." >&2
        echo "================================================================================" >&2
        echo "" >&2
        exit_code=1
        continue
      fi
    fi

    # Case 3: Enforce PR-only push if STRICT_BRANCH_PROTECTION is set
    if [[ "${STRICT_BRANCH_PROTECTION:-0}" == "1" ]]; then
      echo "" >&2
      echo "================================================================================" >&2
      echo "🛑 [GIT BLOCKED] Direct push to protected branch '$remote_branch' is disabled." >&2
      echo "   STRICT_BRANCH_PROTECTION is enabled." >&2
      echo "   Please create a feature branch and submit a GitHub Pull Request." >&2
      echo "================================================================================" >&2
      echo "" >&2
      exit_code=1
      continue
    fi
  fi
done

exit $exit_code
